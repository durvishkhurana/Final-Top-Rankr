APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

POSTGRES_USER=topranker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=topranker
DATABASE_URL=postgresql+asyncpg://topranker:change-me@127.0.0.1:5432/topranker
REDIS_URL=redis://127.0.0.1:6379/0

SANDBOX_IMAGE=topranker-sandbox:latest
# runc, or runsc if gVisor is installed
SANDBOX_RUNTIME=runc
SANDBOX_CPU=1
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_SEC=120

# LLM providers. Both are optional; with no key set, AI features are disabled.
# Groq handles high-volume calls; Gemini handles low-volume and image input.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hard cap on Gemini calls per day (free tier is small)
GEMINI_DAILY_LIMIT=18
AI_DAILY_LIMIT_PER_USER=20
AI_DAILY_LIMIT_GLOBAL=500
# Optional, for the cost column of the call log (USD per million tokens)
LLM_PRICE_IN_PER_MILLION=0
LLM_PRICE_OUT_PER_MILLION=0

# Determines the held-out instances of contests; keep it private. Empty: JWT_SECRET is used.
HELDOUT_SECRET=

# Submission limits, per user and problem
SUBMIT_COOLDOWN_SEC=30
SUBMIT_DAILY_CAP=20

INTEGRITY_LOG_RETENTION_DAYS=30

# First admin, created by the seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=change-me
